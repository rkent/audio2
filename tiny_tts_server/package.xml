<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>tiny_tts_server</name>
  <version>0.0.0</version>
  <description>TinyTTS text-to-speech web server (OpenAI-compatible)</description>
  <maintainer email="kent@caspia.com">R. Kent James</maintainer>
  <license>Apache-2.0</license>
  <exec_depend>python3-waitress</exec_depend>
  <exec_depend>python3-flask</exec_depend>
  <depend>tiny_tts</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_mypy</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>ament_xmllint</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
